# Firebase web app config — copy this file to `.env` and fill with your project's values.
# Get these from Firebase console → Project settings → Your apps → Web app.
# NOTE: these are public client keys, not secrets. Security is enforced by
# Firebase Auth + Firestore rules (see firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: OAuth 2.0 Web client id for Google Calendar sync.
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# (the "Web client (auto created by Google Service)" that Firebase set up).
# Also enable the Google Calendar API and add your app origin to the client's
# "Authorized JavaScript origins". Leave blank to hide the calendar feature.
VITE_GOOGLE_CLIENT_ID=
