rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write documents nested under their own uid.
    // Since the app is private to you, this restricts all data to your account.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
